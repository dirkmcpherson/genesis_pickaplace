+def _prepare_video_np2(V):
+    """numpy>=2.3 removed np.reshape's `newshape` kwarg, which torch 2.8's
+    torch.utils.tensorboard._utils._prepare_video still passes -> TypeError on
+    every add_video. Drop-in replacement (same semantics: (B,T,C,H,W) float/uint8
+    -> (T, n_rows*H, n_cols*W, C) grid), installed below."""
+    b, t, c, h, w = V.shape
+    if V.dtype == np.uint8:
+        V = np.float32(V) / 255.0
+    if b & (b - 1) != 0:  # pad batch to the next power of two
+        pad = int(2 ** b.bit_length() - b)
+        V = np.concatenate((V, np.zeros((pad, t, c, h, w), dtype=V.dtype)), axis=0)
+    n_rows = 2 ** ((b.bit_length() - 1) // 2)
+    n_cols = V.shape[0] // n_rows
+    V = V.reshape(n_rows, n_cols, t, c, h, w)
+    V = np.transpose(V, axes=(2, 0, 4, 1, 5, 3))
+    return V.reshape(t, n_rows * h, n_cols * w, c)
+
+
+import torch.utils.tensorboard.summary as _tb_summary  # noqa: E402
+
+_tb_summary._prepare_video = _prepare_video_np2
+
