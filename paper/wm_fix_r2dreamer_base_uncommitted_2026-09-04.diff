+class BoundFull(Bound):
+    """Bound that also projects rsample. Bound only overrides sample/mode;
+    rsample falls through __getattr__ to the RAW dist -- and rsample is what
+    both the collect path (dreamer.act) and imagination (_imagine) call, so a
+    Bound-wrapped actor still emits unbounded actions everywhere it matters."""
+
+    def rsample(self, sample_shape=()):
+        out = self._dist.rsample(sample_shape)
+        return out / torch.clip(torch.abs(out), min=1.0).detach()
+
+
+def bounded_normal_clipped(x, min_std, max_std, **kwargs):
+    """bounded_normal whose SAMPLES are projected into [-1,1] (straight-through:
+    the divisor is detached, matching Bound.sample's convention).
+
+    Why (genesis, 2026-08-10): plain bounded_normal tanh-bounds the MEAN only;
+    with entropy-driven std near max_std=1.0 the actor sampled at +-4
+    (train/action_max 3.8/-4.3 in pick_delta_s0). The env clips to [-1,1] before
+    executing, but the replay buffer and imagination keep the RAW sample -- the
+    world model learns dynamics conditioned on action values that were never
+    executed (the same action-scale bug family as the unnormalized-demo one that
+    poisoned runs v6-v13), and log_prob of +-4 tail samples fed the actor update.
+    Env configs opt in via env.actor_dist; their benchmarks keep bounded_normal."""
+    mean, std = torch.chunk(x, 2, dim=-1)
+    std = (max_std - min_std) * torch.sigmoid(std + 2.0) + min_std
+    dist = torchd.normal.Normal(torch.tanh(to_f32(mean)), to_f32(std))
+    return BoundFull(torchd.independent.Independent(dist, 1))
+
+
 def normal_std_fixed(mean, std, **kwargs):
     dist = torchd.normal.Normal(to_f32(mean), to_f32(std))
     return Bound(torchd.independent.Independent(dist, 1))
