diff --git a/configs/env/genesis_pick_v5d4c_delta_shaped.yaml b/configs/env/genesis_pick_v5d4c_delta_shaped.yaml
new file mode 100644
index 0000000..4d3e965
--- /dev/null
+++ b/configs/env/genesis_pick_v5d4c_delta_shaped.yaml
@@ -0,0 +1,86 @@
+# genesis_pick_v5d4c_delta: v5d4 (champion recipe) + RETURN-TARGET CLAMP pilot
+# from the pick_delta_s0 lunge forensics + user directive "restrict the range
+# of the env's diff_joint action space so it's not so different from the demos").
+#
+# pick_delta_s0 (v4_delta) showed the first genuine learning transient (train
+# picked 0.24 @128k, entropy collapsed to -5) then decayed while the policy
+# LUNGED at the can (eval: tips in 1-2 agent steps, forearm strikes; grid video
+# r2dreamer_genesis/f1jbsa0b). Three compounding causes, all fixed here:
+#
+# 1. actor_dist bounded_normal_clipped: stock bounded_normal tanh-bounds the
+#    MEAN only -- with entropy-driven std near max_std 1.0 the actor SAMPLED at
+#    +-4 (train/action_max 3.8/-4.3). The env executes clip(a) but the buffer
+#    and imagination keep the raw sample: world model conditioned on fictional
+#    actions (the v6-v13 demo-scale bug family, policy side), log_prob of tail
+#    samples in the actor update, and every |a|>1 sample = saturated max-speed
+#    command. bounded_normal_clipped projects samples (incl. rsample -- the
+#    method collect and imagination actually call) into [-1,1].
+# 2. delta_cap 0.04 -> 0.025: the demos' p99 per-frame commanded delta is
+#    0.0259 rad (median 0.002 -- humans are mostly nearly still). At cap 0.04 a
+#    saturated action moves 69 deg/s, 1.5x beyond anything demonstrated; at
+#    0.025 saturation = the demos' p99 speed (44 deg/s). Re-encode cost: 1.31%
+#    of demo frames clip (replay-gated below). Demo set MUST be re-encoded at
+#    this cap: demonstrations/genesis_pick_pruned_delta25.
+# 3. act_entropy 3e-4 -> 3e-5: v4_delta silently inherited v3's ManiSkill-stock
+#    3e-4 -- 10x the locally-proven v2 recipe value. pick_delta_s0's rate decay
+#    (0.24 -> 0.08) tracked entropy re-ratcheting between demo re-injections.
+#
+# delta_leash_mult 5: the leash bounds |target - qpos| and must stay >= the
+# demos' ABSOLUTE PD lead (p99 0.126 rad) regardless of cap: 5 * 0.025 = 0.125
+# (v4: 3 * 0.04 = 0.12). Everything else inherited from v4_delta.
+
+task: 'genesis_pick'
+steps: 3e6
+env_num: 6               # ONE Genesis CPU world per spawn worker
+eval_episode_num: 0      # eval builds eval_episode_num EXTRA worlds -- keep 0 for now
+action_repeat: 4         # adapter-side: 1 agent step = 4 sim steps; in delta mode the
+                         # target integrates a*delta_cap on EACH of the 4 sim steps
+demo_downsample: 4       # MUST equal action_repeat (demo_prefill asserts)
+train_ratio: 512         # = 1 update / 2 agent steps at repeat 4 (MS-like intensity)
+time_limit: 400          # sim steps; // action_repeat -> 100 AGENT steps (MS parity)
+
+seed: ${seed}
+device: ${device}
+
+size: [64, 64]
+scope: 'pick'            # +1 and terminate on the pick
+action_mode: delta_joint
+delta_cap: 0.025         # rad per sim step per arm dim = demo p99 speed; MUST match
+                         # the demo set's encoding cap (genesis_pick_pruned_delta25)
+delta_leash_mult: 5      # 5 * 0.025 = 0.125 >= demo PD-lead p99 0.126 (see header)
+actor_dist: bounded_normal_clipped   # consumed by model/_base_.yaml oc.select hook
+actor_bc_lambda: 0.0     # MUST STAY 0 (user, 2026-08-11): actor-BC imitates the
+                         # demonstrator's actions and CONFOUNDS the H4 design --
+                         # the world-model arm must consume demos as
+                         # dynamics/reward DATA only. Non-confounding levers for
+                         # the exploration-starvation problem: demo_duplicate,
+                         # demo_reinject_every, act_entropy, budget.
+demo_dir: null           # set to .../dreamerv3-torch/demonstrations/genesis_pick_pruned_delta25
+demo_reinject_every: 150000  # d4: halved cadence (proven with duplicate 4)
+demo_duplicate: 4       # d4: demos ~10%% of full buffer (43k of 450k rows)
+reward_scale: 100.0      # env AND demo rewards (same factor both places)
+
+# Consumed via ${oc.select:...} hooks in configs.yaml / model/_base_.yaml:
+storage_device: cpu      # 64x64x6 uint8 replay stays in RAM
+horizon: 333             # discount 0.997; pick at ~100 agent steps -> 0.74 visibility
+act_entropy: 3e-5        # v2-recipe value (NOT v3/v4's stock 3e-4 -- see header)
+
+encoder:
+  mlp_keys: '$^'
+  cnn_keys: 'image'
+decoder:                 # unused unless model.rep_loss=dreamer, but the group is referenced
+  mlp_keys: '$^'
+  cnn_keys: 'image'
+# --- v5d4 provenance (2026-08-11) -------------------------------------------
+# This is the CHAMPION recipe: pick_delta25d4_s0 produced CHAMPION_1576820
+# (eval 0.91 sampled n=45 / 1.00 mode, demo ICs, hardened predicate) and an
+# independent 0.87 draw 400k steps later. Training is BISTABLE (lambda-return
+# explosion past the 100 max -- diagnosed, unpatched): checkpoints are a phase
+# lottery, so the sbatch runs an archive+eval+prune loop and a best-checkpoint
+# confirmation stage. Known caveat: discovery-phase seed variance is severe
+# (seed 1 never discovered in 1.9M steps).
+return_clamp: 100.0    # = reward_scale * pick(+1); the known max return (clamp pilot)
+# DENSE variant (08-19): champion recipe + TRAINING-ONLY pick-scope potential
+# shaping (FullTaskEnv pick_shaping, gamma=0.999 in the wrapper). Eval metric
+# unchanged (sparse fresh picked). See genesis_pickaplace paper/ROUND_ROBIN doc.
+pick_shaping: true
