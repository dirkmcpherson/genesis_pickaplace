diff -ruN a/sbatch_genesis_final_rr.sh b/sbatch_genesis_final_rr.sh
--- a/sbatch_genesis_final_rr.sh	1969-12-31 19:00:00.000000000 -0500
+++ b/sbatch_genesis_final_rr.sh	2026-08-23 05:33:01.448236251 -0400
@@ -0,0 +1,168 @@
+#!/bin/bash
+# FINAL ROUND ROBIN dv3 launcher -- ONE run per job, ARM x REWARD x SEED.
+# (genesis_pickaplace paper/PREREG_final_round_robin_2026-08-23.md §1, §2, §5; dv3 is
+#  QUEUED LAST in the block and runs the longer budget.)
+#
+# Submit (from the dreamerv3-torch root, the genesis env active as for sbatch_genesis_multi.sh):
+#   ARM=dH   REWARD=sparse SEED=0 sbatch sbatch_genesis_final_rr.sh
+#   ARM=dDP  REWARD=dense  SEED=1 sbatch sbatch_genesis_final_rr.sh
+#   DRYRUN=1 ARM=dR2D REWARD=sparse SEED=0 bash sbatch_genesis_final_rr.sh     # prints, runs nothing
+#
+# Knobs (env): ARM dH|dDP|dR2D (demo dir = demonstrations/genesis_final_${ARM}_r4, a
+#   to_dreamer_native.py output with repeat.json action_repeat 4 / terminal_reward 100;
+#   override with DEMODIR), REWARD sparse|dense (dense = + the genesis_pick_msrecipe_shaped
+#   overlay, exactly as the 08-19 round robin), SEED (required), STEPS (default from the
+#   genesis_final_rr overlay: 1e6), EVAL_IC_FILE (default
+#   $GENESIS_PICKAPLACE_ROOT/baselines/eval_ics.json), EVAL_MAX_STEPS (1200).
+#
+# What it does, in order:
+#   1. provenance gates: demo dir exists, repeat.json stride == 4, contract v1 stamp, sha of the
+#      episode list recorded; RUN_REGISTRY check/register at job START (genesis_pickaplace
+#      cluster/run_registry.py; refuses an exact repeat) with knobs incl. horizon/repeat/unit/sha
+#   2. train: dreamer.py --configs genesis_pixels genesis_pick_msrecipe [genesis_pick_msrecipe_shaped]
+#      genesis_final_rr --action_repeat 4 --seed $SEED --demodir ... --steps $STEPS
+#   3. CHECKPOINT ARCHIVE (K=5): a watcher copies latest.pt -> ckpt_{20,40,60,80,100}/latest.pt the
+#      first time metrics.jsonl's step crosses 20/40/60/80/100 % of STEPS (polling resolution:
+#      ~latest.pt write cadence; the archived step is recorded in ckpt_XX/step.txt). The final
+#      checkpoint is always archived as ckpt_100 after training exits.
+#   4. EVAL (PREREG §5): for each archived checkpoint, genesis_eval.py one episode per FRESH
+#      process on the `sel` set (15) -> selection; the selected checkpoint (+ the final one) on
+#      `hold` (15) + `rnd` (30); horizon EVAL_MAX_STEPS=1200; CPU-side genesis (CUDA hidden),
+#      <= 1 world per 2 cores. Per-episode JSON lines -> <run>/eval/<ckpt>/<set>/episodes.jsonl;
+#      aggregated with ASSERTED denominators into <run>/eval/sweep.json and one
+#      DV3-RESULT arm= reward= seed= ckpt= sel=a/15 hold=b/15 rnd=c/30 line (missing episodes
+#      are reported missing, never 0).
+#   5. registry register at END with the result (the START registration already claimed the cell).
+#
+#SBATCH -J dv3-final-rr
+#SBATCH -p gpu,preempt
+#SBATCH --requeue
+#SBATCH --gres=gpu:1
+#SBATCH --constraint="l40s|l40|h200|a100"
+#SBATCH -N 1
+#SBATCH -n 16
+#SBATCH --mem=64g
+#SBATCH -t 2-00:00:00
+set -u
+: "${ARM:?ARM=dH|dDP|dR2D}"; : "${SEED:?SEED required (paired seed index across sources)}"
+REWARD=${REWARD:-sparse}
+case "$REWARD" in sparse) SHAPED= ;; dense) SHAPED=genesis_pick_msrecipe_shaped ;; *) echo "FATAL: REWARD=$REWARD"; exit 1;; esac
+case "$ARM" in dH|dDP|dR2D) ;; *) echo "FATAL: ARM=$ARM"; exit 1;; esac
+PY=${PY:-python}
+GPR=${GENESIS_PICKAPLACE_ROOT:-$HOME/genesis_pickaplace}
+DEMOD=${DEMODIR:-demonstrations/genesis_final_${ARM}_r4}
+TAG="final_${ARM}_DV3${SHAPED:+-dense}_s${SEED}"
+RUNDIR="logs_cluster/genesis_final/${TAG}"
+STEPS=${STEPS:-1000000}
+EVAL_IC_FILE=${EVAL_IC_FILE:-$GPR/baselines/eval_ics.json}
+EVAL_MAX_STEPS=${EVAL_MAX_STEPS:-1200}
+ACTREP=4
+echo "== node $(hostname) job ${SLURM_JOB_ID:-local} $(date) | $TAG demo=$DEMOD steps=$STEPS"
+
+REG_PY="$GPR/cluster/run_registry.py"; REG="$GPR/cluster/RUN_REGISTRY.jsonl"
+REG_KNOBS=(learner=dv3 reward=$REWARD action_repeat=$ACTREP train_horizon=1200 eval_horizon=$EVAL_MAX_STEPS budget_unit=sim_steps budget=$STEPS contract=v1)
+if [ -n "${DRYRUN:-}" ]; then
+  echo "[dry] TAG=$TAG RUNDIR=$RUNDIR DEMOD=$DEMOD (gates skipped in dry-run) configs: genesis_pixels genesis_pick_msrecipe ${SHAPED:-} genesis_final_rr"
+  echo "[dry] registry: $PY $REG_PY check --script sbatch_genesis_final_rr.sh --arm ${ARM}${SHAPED:+-dense} --seed $SEED --demo-dir $DEMOD --registry $REG ${REG_KNOBS[*]}"
+  echo "[dry] train: $PY dreamer.py --configs genesis_pixels genesis_pick_msrecipe ${SHAPED:-} genesis_final_rr --action_repeat $ACTREP --seed $SEED --demodir $DEMOD --steps $STEPS --logdir $RUNDIR"
+  echo "[dry] eval: genesis_eval.py --ic-file $EVAL_IC_FILE --ic-set {sel,hold,rnd} --ic-index k --max-steps $EVAL_MAX_STEPS (one fresh process per episode, CPU)"
+  exit 0
+fi
+
+# --- 1. provenance gates ---------------------------------------------------------------
+[ -d "$DEMOD" ] || { echo "FATAL: demo dir missing: $DEMOD (to_dreamer_native.py output; rsync ONLY)"; exit 1; }
+[ -f "$DEMOD/repeat.json" ] || { echo "FATAL: $DEMOD has no repeat.json stamp (not a to_dreamer_native.py output)"; exit 1; }
+DSTRIDE=$("$PY" -c "import json;print(json.load(open('$DEMOD/repeat.json'))['action_repeat'])")
+DCONTRACT=$("$PY" -c "import json;print(json.load(open('$DEMOD/repeat.json')).get('contract','legacy'))")
+[ "$DSTRIDE" = "$ACTREP" ] || { echo "FATAL: demo stride $DSTRIDE != action_repeat $ACTREP"; exit 1; }
+[ "$DCONTRACT" = "v1" ] || { echo "FATAL: $DEMOD is not a contract-v1 set (stamp contract=$DCONTRACT); the final round robin trains on recorder output only"; exit 1; }
+NDEMO=$(ls "$DEMOD"/*.npz 2>/dev/null | wc -l); [ "$NDEMO" -ge 1 ] || { echo "FATAL: no npz in $DEMOD"; exit 1; }
+DEMO_SHA=$(cd "$DEMOD" && ls *.npz | sort | sha256sum | cut -c1-16)
+[ -f "$EVAL_IC_FILE" ] || { echo "FATAL: eval IC file missing: $EVAL_IC_FILE (baselines/make_eval_ics.py)"; exit 1; }
+GIT_DV3=$(git -C . rev-parse --short HEAD 2>/dev/null || echo nogit)
+REG_KNOBS+=(demo_sha=$DEMO_SHA demo_n=$NDEMO dv3_git=$GIT_DV3)
+if [ -f "$REG_PY" ]; then
+  "$PY" "$REG_PY" check --script sbatch_genesis_final_rr.sh --arm "${ARM}${SHAPED:+-dense}" --seed "$SEED" \
+     --demo-dir "$DEMOD" --registry "$REG" "${REG_KNOBS[@]}" || { echo "FATAL: registry refused this cell (exact repeat?)"; exit 1; }
+  "$PY" "$REG_PY" register --script sbatch_genesis_final_rr.sh --arm "${ARM}${SHAPED:+-dense}" --seed "$SEED" \
+     --demo-dir "$DEMOD" --registry "$REG" "${REG_KNOBS[@]}" stage=start || true
+else
+  echo "WARN: $REG_PY not found -- run NOT registered (TODO on the deployed tree)"
+fi
+
+# --- 2. train + 3. checkpoint archive watcher ---------------------------------------------
+mkdir -p "$RUNDIR"
+export TI_OFFLINE_CACHE_FILE_PATH="$PWD/$RUNDIR/ticache"; mkdir -p "$TI_OFFLINE_CACHE_FILE_PATH"
+"$PY" dreamer.py --configs genesis_pixels genesis_pick_msrecipe ${SHAPED:-} genesis_final_rr \
+  --action_repeat "$ACTREP" --seed "$SEED" --demodir "$DEMOD" --steps "$STEPS" \
+  --logdir "$RUNDIR" > "$RUNDIR/run.log" 2>&1 &
+TRAIN_PID=$!
+(
+  declare -A DONE
+  while kill -0 "$TRAIN_PID" 2>/dev/null; do
+    L=$(ls -d "$RUNDIR"/*/ 2>/dev/null | head -1)
+    if [ -n "$L" ] && [ -f "$L/latest.pt" ] && [ -f "$L/metrics.jsonl" ]; then
+      STEP=$(tail -1 "$L/metrics.jsonl" 2>/dev/null | grep -oE '"step": [0-9]+' | grep -oE '[0-9]+')
+      for PCT in 20 40 60 80; do
+        if [ -z "${DONE[$PCT]:-}" ] && [ -n "$STEP" ] && [ "$STEP" -ge $(( STEPS * PCT / 100 )) ]; then
+          mkdir -p "$L/ckpt_$PCT"; cp "$L/latest.pt" "$L/ckpt_$PCT/latest.pt"; echo "$STEP" > "$L/ckpt_$PCT/step.txt"
+          echo "== archived ckpt_$PCT at step $STEP $(date)"; DONE[$PCT]=1
+        fi
+      done
+    fi
+    sleep 300
+  done
+) &
+WATCH_PID=$!
+wait "$TRAIN_PID"; TRAIN_RC=$?
+kill "$WATCH_PID" 2>/dev/null || true
+L=$(ls -d "$RUNDIR"/*/ 2>/dev/null | head -1)
+[ -n "$L" ] && [ -f "$L/latest.pt" ] || { echo "FATAL: no checkpoint after training (rc=$TRAIN_RC)"; exit 1; }
+mkdir -p "$L/ckpt_100"; cp "$L/latest.pt" "$L/ckpt_100/latest.pt"
+tail -1 "$L/metrics.jsonl" 2>/dev/null | grep -oE '"step": [0-9]+' | grep -oE '[0-9]+' > "$L/ckpt_100/step.txt"
+echo "== training done rc=$TRAIN_RC $(date); archived: $(ls -d "$L"/ckpt_* | xargs -n1 basename | tr '\n' ' ')"
+
+# --- 4. eval: fresh process per episode, CPU, shared IC file ---------------------------------
+NCPU=${SLURM_CPUS_PER_TASK:-16}; PAR=$(( NCPU / 2 )); [ "$PAR" -ge 1 ] || PAR=1
+EVALROOT="$RUNDIR/eval"; mkdir -p "$EVALROOT"
+run_set() {  # $1 = ckpt dir (holds latest.pt)  $2 = set name  $3 = n episodes
+  local CK="$1" SET="$2" N="$3" OUT="$EVALROOT/$(basename "$CK")/$SET"; mkdir -p "$OUT"
+  # genesis_eval.py loads <logdir>/latest.pt and the run config from the run dir: point a
+  # symlinked logdir at the archived checkpoint so the rebuilt agent == the archived weights.
+  local LD="$OUT/logdir"; rm -rf "$LD"; mkdir -p "$LD"; ln -s "$(realpath "$CK/latest.pt")" "$LD/latest.pt"
+  for f in "$L"/*.json "$L"/*.yaml "$L"/config* ; do [ -e "$f" ] && ln -sf "$(realpath "$f")" "$LD/" ; done
+  rm -f "$OUT/episodes.jsonl"
+  for k in $(seq 0 $((N - 1))); do
+    ( CUDA_VISIBLE_DEVICES="" "$PY" genesis_eval.py --logdir "$LD" --configs genesis_pixels genesis_pick_msrecipe ${SHAPED:-} genesis_final_rr \
+        --ic-file "$EVAL_IC_FILE" --ic-set "$SET" --ic-index "$k" --max-steps "$EVAL_MAX_STEPS" --device cpu \
+        --out "$OUT/ep_$k" --no-wandb > "$OUT/ep_$k.log" 2>&1
+      cat "$OUT/ep_$k/episodes.jsonl" >> "$OUT/episodes.jsonl" 2>/dev/null ) &
+    while [ "$(jobs -rp | wc -l)" -ge "$PAR" ]; do sleep 5; done
+  done
+  wait
+  local GOT=$(wc -l < "$OUT/episodes.jsonl" 2>/dev/null || echo 0)
+  local PICKED=$(grep -c '"picked": true' "$OUT/episodes.jsonl" 2>/dev/null || echo 0)
+  echo "$(basename "$CK") $SET picked=$PICKED/$GOT expected=$N" | tee -a "$EVALROOT/sweep.txt"
+  [ "$GOT" -eq "$N" ] || echo "WARN: $(basename "$CK") $SET: $GOT/$N episodes returned (MISSING, not zero)" | tee -a "$EVALROOT/sweep.txt"
+}
+for CK in "$L"/ckpt_*; do run_set "$CK" sel 15; done
+BEST=$(grep ' sel picked=' "$EVALROOT/sweep.txt" | awk '{split($3,a,"[=/]"); print a[2], $1}' | sort -k1,1nr -k2,2 | head -1 | awk '{print $2}')
+echo "== selected checkpoint: $BEST"
+run_set "$L/$BEST" hold 15; run_set "$L/$BEST" rnd 30
+[ "$BEST" != "ckpt_100" ] && { run_set "$L/ckpt_100" hold 15; run_set "$L/ckpt_100" rnd 30; }
+SEL=$(grep "^$BEST sel " "$EVALROOT/sweep.txt" | head -1 | grep -oE 'picked=[0-9]+/[0-9]+' | cut -d= -f2)
+HOLD=$(grep "^$BEST hold " "$EVALROOT/sweep.txt" | head -1 | grep -oE 'picked=[0-9]+/[0-9]+' | cut -d= -f2)
+RND=$(grep "^$BEST rnd " "$EVALROOT/sweep.txt" | head -1 | grep -oE 'picked=[0-9]+/[0-9]+' | cut -d= -f2)
+"$PY" - "$EVALROOT/sweep.txt" "$EVALROOT/sweep.json" "$TAG" "$BEST" <<'PYEOF'
+import sys, json, re
+rows = [l.split() for l in open(sys.argv[1]) if ' picked=' in l and not l.startswith('WARN')]
+out = {}
+for ck, st, pk, ex in rows:
+    m = re.match(r'picked=(\d+)/(\d+)', pk); out.setdefault(ck, {})[st] = dict(picked=int(m.group(1)), n=int(m.group(2)), expected=int(ex.split('=')[1]))
+json.dump(dict(tag=sys.argv[3], selected=sys.argv[4], results=out), open(sys.argv[2], 'w'), indent=1)
+PYEOF
+echo "DV3-RESULT arm=$ARM reward=$REWARD seed=$SEED ckpt=$BEST sel=${SEL:-MISSING} hold=${HOLD:-MISSING} rnd=${RND:-MISSING} horizon=$EVAL_MAX_STEPS repeat=$ACTREP demo_sha=$DEMO_SHA"
+# --- 5. registry end ------------------------------------------------------------------------
+[ -f "$REG_PY" ] && "$PY" "$REG_PY" register --script sbatch_genesis_final_rr.sh --arm "${ARM}${SHAPED:+-dense}" --seed "$SEED" \
+     --demo-dir "$DEMOD" --registry "$REG" "${REG_KNOBS[@]}" stage=end "result_sel=${SEL:-MISSING}" "result_hold=${HOLD:-MISSING}" "result_rnd=${RND:-MISSING}" || true
+echo "== done $(date) rc=$TRAIN_RC"
